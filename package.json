{
  "name": "autheo-dev-docs",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:build": "node scripts/build.mjs && node scripts/check-dist.mjs",
    "docs:build:pages": "npm run docs:build",
    "docs:preview": "node scripts/serve.mjs",
    "docs:dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run docs:build",
    "export": "node scripts/export.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "check:links": "node scripts/check-links.mjs",
    "provenance": "node scripts/provenance.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "cheerio": "1.2.0",
    "markdown-it": "14.3.2",
    "markdown-it-container": "4.0.0",
    "playwright-core": "1.64.0"
  }
}
